# Environment Configuration for Cypress Sentinel

# Base URL untuk testing
BASE_URL=https://www.google.com

# SPEC_PATTERN - Pilih test suite mana yang akan dijalankan
# Options:
#   1. Functional tests only:
#      SPEC_PATTERN=cypress/e2e/functional/**/*.cy.js
#
#   2. Performance tests only:
#      SPEC_PATTERN=cypress/e2e/performance/**/*.cy.js
#
#   3. Security tests only:
#      SPEC_PATTERN=cypress/e2e/security/**/*.cy.js
#
#   4. All tests:
#      SPEC_PATTERN=cypress/e2e/**/*.cy.js
#
# Default: All tests
SPEC_PATTERN=cypress/e2e/**/*.cy.js
